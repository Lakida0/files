# Cloudflare Pages caching rules.
#
# Goal: shared assets are fetched once and then come from the browser cache,
# while every HTML page can still pick up a new deploy.
#
# Pages applies rules in order and the LAST match wins, so the broad default
# comes first, directory rules follow, and the HTML revalidation rules come
# last so they cannot be shadowed by a longer cache on their directory.

# --- Default: revalidate ---------------------------------------------------
/*
  Cache-Control: public, max-age=0, must-revalidate

# --- Shared assets: cached for a day, with a version-string safety net -----
# history: this was `max-age=31536000, immutable`. That is a trap for files
# edited in place: the browser stops asking entirely, so a fixed site.js kept
# being served from cache while the HTML around it had already updated. A one
# day lifetime plus the ?v= query string on the <link>/<script> tags gives both
# fast repeat loads and a bounded worst case if a version bump is forgotten.
# Keep bumping ?v= when you edit site.js or site.css (see README).
/assets/*
  Cache-Control: public, max-age=86400

# The icon rarely changes and is tiny.
/favicon.ico
  Cache-Control: public, max-age=604800

# --- Streaming -------------------------------------------------------------
# Playlists are small and must never be stale, otherwise seeking breaks.
/**/*.m3u8
  Cache-Control: public, max-age=60

# Segments are immutable: a segment name is never reused.
/Crab_Rave/stream/*
  Cache-Control: public, max-age=31536000, immutable

/梦想季/stream/*
  Cache-Control: public, max-age=31536000, immutable

/小王子季/stream/*
  Cache-Control: public, max-age=31536000, immutable

/学习资料/stream/*
  Cache-Control: public, max-age=31536000, immutable

# --- Media files -----------------------------------------------------------
# Long-lived but deliberately not "immutable", because a track could be
# re-encoded in place and keep its name.
/music/*
  Cache-Control: public, max-age=2592000

# --- HTML revalidation -----------------------------------------------------
# These must stay after the directory rules above so the last match wins.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/music/*.html
  Cache-Control: public, max-age=0, must-revalidate

/nbs/*.html
  Cache-Control: public, max-age=0, must-revalidate

/Crab_Rave/*.html
  Cache-Control: public, max-age=0, must-revalidate

/WebGL_Demo/*.html
  Cache-Control: public, max-age=0, must-revalidate

/WebGL_Demo/*/*.html
  Cache-Control: public, max-age=0, must-revalidate

/梦想季/*.html
  Cache-Control: public, max-age=0, must-revalidate

/小王子季/*.html
  Cache-Control: public, max-age=0, must-revalidate

/学习资料/*.html
  Cache-Control: public, max-age=0, must-revalidate

/小体积编程大赛优秀作品/*.html
  Cache-Control: public, max-age=0, must-revalidate

# --- Plain-text project files ---------------------------------------------
/README.md
  Cache-Control: public, max-age=3600
